---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../data/site'

const contacts = [
  {
    name: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    stroke: true,
  },
  {
    name: 'GitHub',
    value: site.github.replace('https://', ''),
    href: site.github,
    icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
    stroke: false,
  },
]
---

<BaseLayout title={`聯絡我｜${site.name}`}>
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white animate-slide-up">聯絡我</h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        工作機會、技術合作或專案諮詢，都歡迎來信。通常 24 小時內回覆。
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {contacts.map((c) => (
          <a
            href={c.href}
            target={c.href.startsWith('http') ? '_blank' : undefined}
            rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group flex items-center gap-4 rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-md transition-all"
          >
            <span class="w-11 h-11 shrink-0 rounded-full bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-700 dark:text-brand-300">
              {c.stroke
                ? <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={c.icon} /></svg>
                : <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d={c.icon} /></svg>}
            </span>
            <span class="min-w-0">
              <span class="block text-xs tracking-[0.16em] uppercase text-slate-500">{c.name}</span>
              <span class="block mt-0.5 font-medium text-slate-900 dark:text-slate-100 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors break-all">{c.value}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
