---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../data/site'

const contacts = [
  {
    name: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    suit: '♠'
  },
  {
    name: 'GitHub',
    value: site.github.replace('https://', ''),
    href: site.github,
    icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
    suit: '♣'
  },
]
---

<BaseLayout title={`聯絡我｜${site.name}`}>
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Hero CTA -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-amber-100 dark:bg-amber-900/30 rounded-full mb-6">
          <span class="text-4xl text-amber-600 dark:text-amber-400">♠</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 animate-slide-up">準備好開始了嗎？</h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          無論是技術合作、專案諮詢，還是純粹想聊聊德州撲克，都歡迎聯繫我。
        </p>
      </div>

      <!-- Quick Response Promise -->
      <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-xl p-6 mb-12 text-white text-center">
        <div class="flex items-center justify-center gap-2 text-lg font-medium">
          <span class="text-2xl">⚡</span>
          <span>通常 24 小時內回覆</span>
        </div>
      </div>

      <!-- Contact Cards -->
      <div class="grid gap-4 md:grid-cols-2 max-w-2xl mx-auto">
        {contacts.map((contact) => (
          <a
            href={contact.href}
            target={contact.href.startsWith('http') ? '_blank' : undefined}
            rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group relative bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl p-6 hover:border-amber-300 dark:hover:border-amber-600 hover:shadow-lg transition-all"
          >
            <!-- Suit indicator -->
            <div class="absolute top-3 right-3 text-2xl text-gray-200 dark:text-gray-700 group-hover:text-amber-400 transition-colors">
              {contact.suit}
            </div>

            <div class="flex flex-col items-center text-center">
              <div class="w-14 h-14 bg-stone-50 dark:bg-gray-700 rounded-full flex items-center justify-center mb-4 group-hover:bg-amber-50 dark:group-hover:bg-amber-900/30 transition-colors">
                {contact.name === 'Email' ? (
                  <svg class="w-6 h-6 text-gray-600 dark:text-gray-400 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={contact.icon} />
                  </svg>
                ) : (
                  <svg class="w-6 h-6 text-gray-600 dark:text-gray-400 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d={contact.icon} />
                  </svg>
                )}
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-500 mb-1">{contact.name}</p>
              <p class="text-gray-900 dark:text-gray-100 font-medium group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors break-all">
                {contact.value}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- FAQ Section -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 text-center mb-8">常見問題</h2>

        <div class="space-y-4">
          <details class="group bg-stone-50 dark:bg-gray-800 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer">
              <span class="font-medium text-gray-900 dark:text-gray-100">你接什麼類型的專案？</span>
              <span class="text-amber-500 group-open:rotate-180 transition-transform">♦</span>
            </summary>
            <div class="px-5 pb-5 text-gray-600 dark:text-gray-400">
              主要專注於博弈系統、平台架構、金融交易系統的開發。對於高併發、即時性要求高的系統特別有經驗。
            </div>
          </details>

          <details class="group bg-stone-50 dark:bg-gray-800 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer">
              <span class="font-medium text-gray-900 dark:text-gray-100">合作方式是什麼？</span>
              <span class="text-amber-500 group-open:rotate-180 transition-transform">♦</span>
            </summary>
            <div class="px-5 pb-5 text-gray-600 dark:text-gray-400">
              可以是專案制、顧問諮詢或長期合作。具體方式可以根據需求討論。
            </div>
          </details>

          <details class="group bg-stone-50 dark:bg-gray-800 rounded-lg">
            <summary class="flex items-center justify-between p-5 cursor-pointer">
              <span class="font-medium text-gray-900 dark:text-gray-100">你真的會打德州撲克嗎？</span>
              <span class="text-amber-500 group-open:rotate-180 transition-transform">♦</span>
            </summary>
            <div class="px-5 pb-5 text-gray-600 dark:text-gray-400">
              當然！德州撲克教會我很多：風險管理、機率計算、保持冷靜...這些在寫程式時都很有用。有機會可以切磋一下。
            </div>
          </details>
        </div>
      </div>

      <!-- Personal Note -->
      <div class="mt-12 p-6 bg-gradient-to-br from-amber-50 to-amber-100 dark:from-amber-900/20 dark:to-amber-800/20 border-l-4 border-amber-500 rounded-r-lg">
        <div class="flex items-start gap-4">
          <span class="text-3xl">💡</span>
          <div>
            <p class="font-medium text-gray-900 dark:text-gray-100 mb-2">一點小提示</p>
            <p class="text-gray-700 dark:text-gray-300">
              如果你也是德州撲克愛好者，或者對博弈、金融系統有興趣，特別歡迎聊聊！
              也許我們能找到一些有趣的合作機會。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
