---
import BaseLayout from '../layouts/BaseLayout.astro'
import TimelineItem from '../components/TimelineItem.astro'
import { getCollection } from 'astro:content'
import { site } from '../data/site'
import { summary, skillGroups, education, yearsOfExperience } from '../data/profile'

const experiences = await getCollection('experience')
const sortedExperiences = experiences.sort((a, b) => {
  const dateA = a.data.endDate || '9999-12'
  const dateB = b.data.endDate || '9999-12'
  return dateB.localeCompare(dateA)
})

---

<BaseLayout title={`經歷｜${site.name}`}>
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 animate-slide-up">工作經歷</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">
        {summary}
      </p>


      <!-- Timeline -->
      <div class="mt-12">
        {sortedExperiences.length > 0 ? (
          sortedExperiences.map(async (exp, index) => {
            const { Content } = await exp.render()
            return (
              <TimelineItem
                company={exp.data.company}
                position={exp.data.position}
                startDate={exp.data.startDate}
                endDate={exp.data.endDate}
                location={exp.data.location}
                duration={exp.data.duration}
                stack={exp.data.stack}
                index={index}
              >
                <Content />
              </TimelineItem>
            )
          })
        ) : (
          <p class="text-gray-500 dark:text-gray-500">尚無工作經歷資料。</p>
        )}
      </div>

      <!-- Skills Section -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">技能手牌</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">{yearsOfExperience} 年開發經驗，依領域分成四種花色。</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {skillGroups.map((g) => (
            <div class="relative bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
              <div class:list={['absolute top-3 right-4 text-3xl', g.suit === '♥' || g.suit === '♦' ? 'text-red-500/70' : 'text-gray-900/60 dark:text-gray-100/60']}>{g.suit}</div>
              <h3 class="font-semibold text-gray-900 dark:text-gray-100">{g.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2 pr-8">
                {g.skills.map((skill) => (
                  <span class="px-2.5 py-1 text-sm rounded-full bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">學歷與訓練</h2>
        <ul class="mt-6 space-y-3">
          {education.map((e) => (
            <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 bg-stone-50 dark:bg-gray-800 rounded-lg px-5 py-4">
              <span class="text-sm text-gray-500 sm:w-44 shrink-0">{e.period}</span>
              <span class="text-gray-900 dark:text-gray-100 font-medium">{e.school}</span>
              <span class="text-gray-600 dark:text-gray-400">{e.program}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
