---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../data/site'
import { summary, skillGroups, yearsOfExperience } from '../data/profile'

const facts = [
  { label: '開發經驗', value: `${yearsOfExperience} 年` },
  { label: '主力技術', value: 'Java / Spring Boot' },
  { label: '前端', value: 'Vue 2/3 · TypeScript' },
  { label: '擅長領域', value: '交易系統 · 金流整合' },
]

const domains = [
  { title: '交易系統', body: '注單、交易、訂單管理與結算，處理高併發場景下的效能瓶頸。' },
  { title: '金流整合', body: '第三方支付串接、幣別與法幣轉換、多幣別與多語系架構。' },
  { title: '平台開發', body: 'B2B／B2C 平台、管理後台、API 設計與即時通訊系統整合。' },
]

const hobbies = ['德州撲克', '偶爾彈彈鋼琴', '電玩休閒玩家']
---

<BaseLayout title={`${site.name}｜${site.title}`}>
  <!-- Hero -->
  <section class="border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-6 py-20 md:py-24 grid gap-12 md:grid-cols-[1.5fr_1fr] md:items-center">
      <div>
        <p class="text-sm font-medium tracking-[0.18em] uppercase text-brand-700 dark:text-brand-300 animate-slide-up">{site.title} · Taiwan</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-slate-900 dark:text-white animate-slide-up">嗨，我是 {site.name}</h1>
        <p class="mt-6 text-lg text-slate-600 dark:text-slate-400 leading-relaxed animate-slide-up-delay">{summary}</p>
        <div class="mt-8 flex flex-wrap gap-3 animate-slide-up-delay">
          <a href="/experience" class="inline-flex items-center px-6 py-3 rounded-md bg-brand-800 text-white font-medium hover:bg-brand-900 dark:bg-brand-300 dark:text-brand-950 dark:hover:bg-brand-200 transition-colors">看工作經歷</a>
          <a href="/contact" class="inline-flex items-center px-6 py-3 rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:border-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">聯絡我</a>
        </div>
      </div>

      <dl class="rounded-xl border border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
        {facts.map((f) => (
          <div class="px-6 py-4">
            <dt class="text-xs tracking-[0.16em] uppercase text-slate-500">{f.label}</dt>
            <dd class="mt-1 font-medium text-slate-900 dark:text-slate-100">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">關於我</h2>
      <div class="mt-6 prose max-w-none">
        <p>
          我偏好務實的解決方案：不過度設計，也不輕忽細節。先讀懂需求、控制風險，再在對的時機做對的技術決定。
        </p>
        <p>
          {yearsOfExperience} 年來從銀行電商專案、政府系統一路做到高併發交易平台與東南亞跨境金流，這些系統容不得差錯，培養了我對穩定性與安全性的執著。近兩年把 Claude Code 與 MCP 帶進日常開發，一個人也能交付完整的全端平台。
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {domains.map((d) => (
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-5">
            <h3 class="font-semibold text-slate-900 dark:text-white">{d.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>

      <blockquote class="mt-12 border-l-4 border-brand-600 dark:border-brand-400 pl-5 py-1">
        <p class="text-slate-700 dark:text-slate-300">「不求一夜暴富，但求細水長流。」</p>
        <p class="mt-1 text-sm text-slate-500">— 我的工程信條</p>
      </blockquote>

      <!-- Skills -->
      <div class="mt-14">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">技術棧</h2>
        <div class="mt-6 space-y-5">
          {skillGroups.map((g) => (
            <div>
              <h3 class="text-xs font-medium text-slate-500 uppercase tracking-[0.16em] mb-2">{g.name}</h3>
              <div class="flex flex-wrap gap-2">
                {g.skills.map((skill) => (
                  <span class="px-3 py-1 rounded-md text-sm bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-14">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">工作之餘</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-400">{hobbies.join('、')}。</p>
      </div>

      <div class="mt-14 flex flex-wrap gap-3">
        <a href="/experience" class="inline-flex items-center px-6 py-3 rounded-md bg-brand-800 text-white font-medium hover:bg-brand-900 dark:bg-brand-300 dark:text-brand-950 dark:hover:bg-brand-200 transition-colors">看完整經歷</a>
        <a href="/projects" class="inline-flex items-center px-6 py-3 rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:border-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">查看作品</a>
      </div>
    </div>
  </section>
</BaseLayout>
