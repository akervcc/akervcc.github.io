---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { site } from '../data/site'
import { getProjects, entrySlug } from '../lib/content'
import { localePath, useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang)
const sortedProjects = await getProjects(lang)
const allTags = [...new Set(sortedProjects.flatMap((p) => p.data.tags))].sort()
---


<BaseLayout title={`${t('title.projects')}｜${site.name}`}>
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 animate-slide-up">{t('projects.title')}</h1>
      <p class="mt-4 text-slate-600 dark:text-slate-400">
        {t('projects.subtitle')}
      </p>

      <!-- Tag Filter -->
      {allTags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          <button
            class="tag-filter px-3 py-1 text-sm rounded-full bg-brand-600 text-white"
            data-tag="all"
          >
            {t('projects.all')}
          </button>
          {allTags.map((tag) => (
            <button
              class="tag-filter px-3 py-1 text-sm rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
              data-tag={tag}
            >
              {tag}
            </button>
          ))}
        </div>
      )}

      <!-- Projects Grid -->
      <div class="mt-8 grid gap-6 md:grid-cols-2" id="projects-grid">
        {sortedProjects.map((project) => (
          <div data-tags={project.data.tags.join(',')}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              tags={project.data.tags}
              href={localePath(lang, `/projects/${entrySlug(project)}`)}
              stats={project.data.stats}
            />
          </div>
        ))}
      </div>

      {sortedProjects.length === 0 && (
        <p class="mt-8 text-slate-500 dark:text-slate-500 text-center">
          {t('projects.empty')}
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll('.tag-filter')
  const projectCards = document.querySelectorAll('#projects-grid > div')

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag')

      // Update active state
      filterButtons.forEach((btn) => {
        btn.classList.remove('bg-brand-600', 'text-white')
        btn.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400')
      })
      button.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400')
      button.classList.add('bg-brand-600', 'text-white')

      // Filter projects
      projectCards.forEach((card) => {
        const cardTags = card.getAttribute('data-tags')?.split(',') || []
        if (tag === 'all' || cardTags.includes(tag)) {
          card.classList.remove('hidden')
        } else {
          card.classList.add('hidden')
        }
      })
    })
  })
</script>
