---
import BaseLayout from '../layouts/BaseLayout.astro'
import type { CollectionEntry } from 'astro:content'
import { site } from '../data/site'
import { localePath, useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
  project: CollectionEntry<'projects'>
}

const { lang, project } = Astro.props
const t = useT(lang)
const { Content } = await project.render()
---


<BaseLayout title={`${project.data.title}｜${site.name}`} description={project.data.description}>
  <article class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Back link -->
      <a
        href={localePath(lang, '/projects')}
        class="inline-flex items-center text-sm text-slate-500 hover:text-brand-600 transition-colors"
      >
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('projects.back')}
      </a>

      <!-- Header -->
      <header class="mt-8">
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100">
          {project.data.title}
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
          {project.data.description}
        </p>

        <!-- Tags -->
        <div class="mt-4 flex flex-wrap gap-2">
          {project.data.tags.map((tag) => (
            <span class="px-2 py-1 text-xs bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-200 border border-brand-100 dark:border-brand-900 rounded">
              {tag}
            </span>
          ))}
        </div>

        <!-- Links -->
        <div class="mt-6 flex flex-wrap gap-4">
          {project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              GitHub
            </a>
          )}
          {project.data.demo && (
            <a
              href={project.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition-colors"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Demo
            </a>
          )}
        </div>
      </header>

      <!-- Featured Image -->
      {project.data.image && (
        <div class="mt-8 rounded-lg overflow-hidden border border-slate-100">
          <img
            src={project.data.image}
            alt={project.data.title}
            class="w-full"
          />
        </div>
      )}

      <!-- Content -->
      <div class="mt-12 prose prose-gray max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
