---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../data/site'
import { profile } from '../data/profile'
import { localePath, useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useT(lang)
const p = profile[lang]
---


<BaseLayout title={`${site.name}｜${site.title}`}>
  <!-- Hero -->
  <section class="border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-6 py-20 md:py-24 grid gap-12 md:grid-cols-[1.5fr_1fr] md:items-center">
      <div>
        <p class="text-sm font-medium tracking-[0.18em] uppercase text-brand-700 dark:text-brand-300 animate-slide-up">{site.title} · Taiwan</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-slate-900 dark:text-white animate-slide-up">{t('home.hi')} {site.name}</h1>
        <p class="mt-6 text-lg text-slate-600 dark:text-slate-400 leading-relaxed animate-slide-up-delay">{p.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3 animate-slide-up-delay">
          <a href={localePath(lang, '/experience')} class="inline-flex items-center px-6 py-3 rounded-md bg-brand-800 text-white font-medium hover:bg-brand-900 dark:bg-brand-300 dark:text-brand-950 dark:hover:bg-brand-200 transition-colors">{t('home.ctaExperience')}</a>
          <a href={localePath(lang, '/contact')} class="inline-flex items-center px-6 py-3 rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:border-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">{t('home.ctaContact')}</a>
        </div>
      </div>

      <dl class="rounded-xl border border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
        {p.facts.map((f) => (
          <div class="px-6 py-4">
            <dt class="text-xs tracking-[0.16em] uppercase text-slate-500">{f.label}</dt>
            <dd class="mt-1 font-medium text-slate-900 dark:text-slate-100">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t('home.about')}</h2>
      <div class="mt-6 prose max-w-none">
        {p.about.map((para) => <p>{para}</p>)}
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {p.domains.map((d) => (
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 p-5">
            <h3 class="font-semibold text-slate-900 dark:text-white">{d.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>

      <blockquote class="mt-12 border-l-4 border-brand-600 dark:border-brand-400 pl-5 py-1">
        <p class="text-slate-700 dark:text-slate-300">{p.quote}</p>
        <p class="mt-1 text-sm text-slate-500">{t('home.quoteBy')}</p>
      </blockquote>

      <!-- Skills -->
      <div class="mt-14">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t('home.stack')}</h2>
        <dl class="mt-6 border-y border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800">
          {p.skillGroups.map((g) => (
            <div class="grid gap-3 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="text-sm font-semibold text-brand-800 dark:text-brand-300 sm:pt-1">{g.name}</dt>
              <dd class="flex flex-wrap gap-2">
                {g.skills.map((skill) => (
                  <span class="px-2.5 py-1 rounded-md text-sm border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300">{skill}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mt-14">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t('home.hobbies')}</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-400">{p.hobbies}</p>
      </div>

      <div class="mt-14 flex flex-wrap gap-3">
        <a href={localePath(lang, '/experience')} class="inline-flex items-center px-6 py-3 rounded-md bg-brand-800 text-white font-medium hover:bg-brand-900 dark:bg-brand-300 dark:text-brand-950 dark:hover:bg-brand-200 transition-colors">{t('home.moreExperience')}</a>
        <a href={localePath(lang, '/projects')} class="inline-flex items-center px-6 py-3 rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:border-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">{t('home.moreProjects')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
