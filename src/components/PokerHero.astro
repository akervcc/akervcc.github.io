---
// Poker cards visual - Ace and King of Spades
---

<div class="relative hidden md:block">
  <!-- Two poker cards -->
  <div class="relative w-64 h-52 flex items-end">
    <!-- King of Spades (behind) -->
    <div class="absolute left-0 bottom-0 w-36 h-48 transform rotate-[-12deg] hover:rotate-[-8deg] transition-transform duration-300">
      <div class="w-full h-full bg-white dark:bg-gray-100 rounded-xl shadow-xl border border-gray-200 p-2 flex flex-col">
        <!-- Top left -->
        <div class="text-left">
          <div class="text-xl font-bold text-gray-900">K</div>
          <div class="text-lg text-gray-900 -mt-1">♠</div>
        </div>

        <!-- Center -->
        <div class="flex-1 flex items-center justify-center">
          <div class="text-5xl text-gray-900">♠</div>
        </div>

        <!-- Bottom right (rotated) -->
        <div class="text-right rotate-180">
          <div class="text-xl font-bold text-gray-900">K</div>
          <div class="text-lg text-gray-900 -mt-1">♠</div>
        </div>
      </div>
    </div>

    <!-- Ace of Spades (front) -->
    <div class="absolute right-0 bottom-0 w-36 h-48 transform rotate-[8deg] hover:rotate-[12deg] transition-transform duration-300 animate-float z-10">
      <div class="w-full h-full bg-white dark:bg-gray-100 rounded-xl shadow-2xl border border-gray-200 p-2 flex flex-col">
        <!-- Top left -->
        <div class="text-left">
          <div class="text-xl font-bold text-gray-900">A</div>
          <div class="text-lg text-gray-900 -mt-1">♠</div>
        </div>

        <!-- Center -->
        <div class="flex-1 flex items-center justify-center">
          <div class="text-5xl text-gray-900">♠</div>
        </div>

        <!-- Bottom right (rotated) -->
        <div class="text-right rotate-180">
          <div class="text-xl font-bold text-gray-900">A</div>
          <div class="text-lg text-gray-900 -mt-1">♠</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative chips (可以刪除這段如果不需要) -->
  <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 flex gap-1">
    <div class="w-6 h-6 rounded-full bg-amber-500 border-2 border-amber-300 shadow-md transform rotate-12"></div>
    <div class="w-6 h-6 rounded-full bg-gray-700 border-2 border-gray-500 shadow-md transform -rotate-6"></div>
    <div class="w-6 h-6 rounded-full bg-amber-600 border-2 border-amber-400 shadow-md transform rotate-3"></div>
  </div>
</div>

<!-- Mobile version -->
<div class="md:hidden flex justify-center gap-2">
  <div class="text-6xl text-amber-500 dark:text-amber-400">A♠</div>
  <div class="text-6xl text-amber-500 dark:text-amber-400">K♠</div>
</div>
