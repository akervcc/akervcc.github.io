---
interface Props {
  title: string
  description: string
  image?: string
  tags: string[]
  slug: string
  stats?: { value: string; label: string }[]
}

const { title, description, image, tags, slug, stats } = Astro.props
---

<a
  href={`/projects/${slug}`}
  class="group flex flex-col h-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-md transition-all"
>
  {image && (
    <div class="aspect-video bg-slate-100 dark:bg-slate-800 overflow-hidden">
      <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
    </div>
  )}

  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors">{title}</h3>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed flex-1">{description}</p>

    {stats && stats.length > 0 && (
      <dl class="mt-5 grid grid-cols-4 gap-2 border-y border-slate-100 dark:border-slate-800 py-3">
        {stats.slice(0, 4).map((stat) => (
          <div class="text-center">
            <dt class="sr-only">{stat.label}</dt>
            <dd class="font-semibold text-slate-900 dark:text-slate-100">{stat.value}</dd>
            <dd class="text-[11px] text-slate-500">{stat.label}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 text-xs rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">{tag}</span>
      ))}
    </div>
  </div>
</a>
